{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chris-dare-dev/math-formal-contract-lean/schema/build-1.0.schema.json",
  "title": "build/1.0 - what the build actually reported",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "env_digest",
    "lake_build_exit",
    "lake_build_jobs",
    "measured",
    "diagnostics",
    "error_count",
    "warning_count",
    "sorry_diagnostic_count",
    "independent_checkers"
  ],
  "properties": {
    "schema_version": {
      "const": "build/1.0"
    },
    "env_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lake_build_exit": {
      "type": "integer",
      "$comment": "RECORDED, NEVER THE GATE. Measured on this toolchain: `lake env lean` on a file whose #print axioms prints [sorryAx] exits 0, and so does -E hasSorry. sorry_diagnostic_count is the gate."
    },
    "lake_build_jobs": {
      "type": "integer",
      "minimum": 0
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "in_scope_modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "$comment": "In-scope module names the NDJSON actually covered. minItems 1: a build.json that measured nothing must not validate."
        },
        "in_scope_modules": {
          "type": "integer",
          "minimum": 1,
          "$comment": "Read from the emission's `modules[]`, never from the caller, so the denominator cannot be shrunk to flatter the numerator."
        }
      },
      "$comment": "A CLEAN BUILD AND AN UNMEASURED BUILD PRODUCE IDENTICAL COUNTS. error_count, warning_count and sorry_diagnostic_count are all 0 whether the build was spotless or the log covered one module of 494, and no other field here can tell the two apart -- the same absence `check-ilean-coverage` exists for, one level down. This block is what distinguishes them. NO RATIO IS STORED: a reader divides. A single `coverage: 100%` would be the collapsed trust token every schema here refuses, and it would be the first thing a tired reader trusted."
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_name",
          "severity",
          "kind",
          "pos",
          "end_pos",
          "data"
        ],
        "properties": {
          "file_name": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "pos": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "column"
            ],
            "properties": {
              "line": {
                "type": "integer"
              },
              "column": {
                "type": "integer"
              }
            }
          },
          "end_pos": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line",
              "column"
            ],
            "properties": {
              "line": {
                "type": "integer"
              },
              "column": {
                "type": "integer"
              }
            }
          },
          "data": {
            "type": "string"
          }
        }
      }
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "sorry_diagnostic_count": {
      "type": "integer",
      "minimum": 0,
      "$comment": "Counted from NDJSON records with kind == hasSorry, never from the exit code."
    },
    "independent_checkers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "value",
          "allow_sorry"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "value": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "not_applicable"
            ]
          },
          "allow_sorry": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "$comment": "A checker that passed WHILE PERMITTING sorry has not checked the thing this axis is about.",
            "if": {
              "properties": {
                "value": {
                  "const": "pass"
                }
              },
              "required": [
                "value"
              ]
            },
            "then": {
              "properties": {
                "allow_sorry": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "Carries no timestamp and no CI identity. Both live in run/1.0, which is NOT committed. This file is regenerated by CI on every commit and is committed, so a field that changes per run makes `git diff --exit-code attest/` red on no-op commits -- see #160."
}
